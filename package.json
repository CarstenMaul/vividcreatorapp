{
  "name": "vca",
  "version": "1.0.3",
  "type": "module",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "vite build --watch --mode development",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "start": "node --import tsx src/server.ts",
    "build": "tsc && vite build",
    "electron:build": "tsc && tsc -p electron && vite build",
    "electron:dev": "npm run electron:build && electron .",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "postinstall": "patch-package",
    "release:bump": "npm version patch -m \"Build v%s\"",
    "sync:version": "node scripts/sync-version.mjs",
    "dist:win": "npm run sync:version && patch-package && npm run electron:build && npm run bundle:runtime && electron-builder --win",
    "dist:mac": "npm run sync:version && npm run electron:build && npm run bundle:runtime && electron-builder --mac",
    "dist:linux": "npm run sync:version && npm run electron:build && electron-builder --linux",
    "notarize:mac": "node scripts/notarize-mac.mjs",
    "dist:mac:signed": "npm run dist:mac && npm run notarize:mac"
  },
  "dependencies": {
    "@azure/core-auth": "^1.10.1",
    "@azure/identity": "^4.13.1",
    "@azure/search-documents": "^13.0.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "archiver": "^7.0.1",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "patch-package": "^8.0.1",
    "proper-lockfile": "^4.1.2",
    "turndown": "^7.2.4",
    "undici": "^8.7.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fontsource/open-sans": "^5.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24",
    "@types/proper-lockfile": "^4.1.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.0",
    "dompurify": "^3.2.7",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.9.0",
    "lucide-react": "^0.469.0",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "allowScripts": {
    "electron@42.5.0": true
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
