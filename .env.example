# VCA local environment — copy to `.env` and adjust.
# The start scripts (start.sh / start.ps1) load this file automatically.
# Every value is optional EXCEPT WORKSPACES_ROOT, which the app requires.
# Leave the Azure/auth/LLM blocks empty for a minimal local run:
#   - no Entra auth -> auth-disabled dev mode (every request is treated as admin)

# --- Core -------------------------------------------------------------------
# Data root for workspaces, sessions and admin config. The start scripts
# default this to ./.vca-data when unset and create the folder for you.
WORKSPACES_ROOT=./.vca-data
# HTTP port (default 3000)
PORT=3000

# --- LLM provider (needed for the agent to actually do work) ----------------
# Pick ONE provider. Examples:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=       # Google AI Studio (Gemini) chat provider — PROVIDER=google
# GOOGLE_API_KEY=       # legacy fallback for Gemini image generation
# PROVIDER=
# MODEL=
# THINKING_LEVEL=

# --- Entra ID auth (optional) -----------------------------------------------
# Set all three to enable login; otherwise the app runs in auth-disabled mode.
# Force-disable even when set with ENTRA_AUTH_ENABLED=0.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# ENTRA_AUTH_ENABLED=0
